# Copie para .env (uso local) ou configure na Vercel.
# Deixe tudo vazio para rodar 100% local, sem login e com dados no disco.

# Senha do dashboard (obrigatoria na Vercel)
DASHBOARD_PASSWORD=

# Segredo para assinar o cookie de login (qualquer texto longo)
AUTH_SECRET=

# Supabase (banco chave-valor na nuvem)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
